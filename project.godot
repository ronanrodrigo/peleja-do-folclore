; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Peleja do Folclore"
config/description="Jogo de luta 2D em pixel art: guardioes do folclore brasileiro contra arquetipos satiricos do poder."
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0705882, 0.0705882, 0.164706, 1)

[autoload]

app_container="*res://autoloads/app_container.gd"

[display]

window/size/viewport_width=426
window/size/viewport_height=240
window/size/window_width_override=1278
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[peleja]

adapters/mode="live"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0705882, 0.0705882, 0.164706, 1)